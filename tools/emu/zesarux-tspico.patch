From 7e4f123fc2457d0ccd507ac4452f8d617976a5bd Mon Sep 17 00:00:00 2001
From: David Anderson <david@andertone.com>
Date: Mon, 15 Jun 2026 15:06:55 -0400
Subject: [PATCH 1/3] TS2068: support 16K EXROM (TS-Pico gus-exrom)

ZEsarUX loaded only an 8K TS2068 EXROM and aliased EX segment 1 to
segment 0 (assuming the 8K chip mirrors across the 16K EXROM window).
Gustavo Pane's TS-Pico ROM uses a full 16K EXROM with the TPI protocol
routines above $2000 (IN/OUT $0E at $2298/$229D), so segment 1 must
hold its own bytes.

- machines/timex.c: drop the seg0->seg1 alias so EX seg1 is its own 8K
  buffer.
- cpu.c (rom_load, TS2068): load a second 8K EXROM page into seg1 from a
  32K ROM image; fall back to mirroring seg0 into seg1 for stock 24K
  TS2068 ROMs (preserves prior behavior).

Booting the 32K gus-home+gus-exrom image now initializes the TS-Pico
EXROM extension: the '(C) 2024 Timex Pico Interface' banner prints.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 src/cpu.c            | 16 ++++++++++++++++
 src/machines/timex.c |  6 +++++-
 2 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/src/cpu.c b/src/cpu.c
index b3d9424..b79920c 100644
--- a/src/cpu.c
+++ b/src/cpu.c
@@ -3599,6 +3599,22 @@ Total 20 pages=320 Kb
             debug_printf(VERBOSE_ERR,"Error loading ROM. Expected size: 8192 Loaded: %d",leidos);
         }
 
+        //TS-Pico / 16K-EXROM support: a 32 KB ROM image carries a second
+        //8 KB EXROM page ($2000-$3FFF when banked into the EX bank). Load
+        //it into EX segment 1. If the image only has an 8 KB EXROM (the
+        //stock 24 KB TS2068 ROM), mirror segment 0 into segment 1 — real
+        //hardware decodes the 8 KB EXROM chip across the whole 16 KB
+        //EXROM window. Requires the seg0->seg1 alias in
+        //timex_init_memory_tables() to be removed so seg1 is its own buffer.
+        leidos=fread(timex_ex_rom_mem_table[1],1,8192,ptr_romfile);
+        if (leidos!=8192) {
+            memcpy(timex_ex_rom_mem_table[1],timex_ex_rom_mem_table[0],8192);
+            debug_printf(VERBOSE_INFO,"TS2068 EXROM: 8 KB image; mirroring EX seg0 into seg1");
+        }
+        else {
+            debug_printf(VERBOSE_INFO,"TS2068 EXROM: loaded full 16 KB (TS-Pico style)");
+        }
+
 
 
     }
diff --git a/src/machines/timex.c b/src/machines/timex.c
index 00887b6..9a19883 100644
--- a/src/machines/timex.c
+++ b/src/machines/timex.c
@@ -218,7 +218,11 @@ void timex_init_memory_tables(void)
 	}
 
 	//Parece que los 8 kb de rom que se cargan en ex rom[0] tambien estan presentes en rom[1]
-	timex_ex_rom_mem_table[1]=timex_ex_rom_mem_table[0];
+	//TS-Pico 16K-EXROM: keep EX segment 1 as its own 8 KB buffer so a 16 KB
+	//EXROM (gus-exrom, code at $2000-$3FFF) maps real bytes. rom_load()
+	//mirrors seg0 into seg1 for stock 8 KB EXROM images, preserving the
+	//original mirror behavior for non-TS-Pico ROMs.
+	//timex_ex_rom_mem_table[1]=timex_ex_rom_mem_table[0];
 	//temp
 	//timex_ex_rom_mem_table[2]=timex_ex_rom_mem_table[0];
 	//timex_ex_rom_mem_table[3]=timex_ex_rom_mem_table[0];
-- 
